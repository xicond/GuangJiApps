<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="certs" />
                    <add segment="logs" />
                </hiddenSegments>
            </requestFiltering>
        </security>
        <handlers>
            <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>
        <!-- IIS akan otomatis mengisi %HTTP_PLATFORM_PORT% dengan port acak yang bebas -->
        <httpPlatform stdoutLogEnabled="true" requestTimeout="00:05:00" stdoutLogFile=".\logs\gin.log" processPath=".\server.exe" arguments="">
            <environmentVariables>
                <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
                <environmentVariable name="GIN_MODE" value="release" />
                <environmentVariable name="GOGC" value="100" />
                <environmentVariable name="GOMEMLIMIT" value="2GiB" />
                <environmentVariable name="JWT_SECRET" value="./certs/dev-private-key.pem" />
                <environmentVariable name="REFRESH_SECRET" value="./certs/dev-private-key.pem" />
                <environmentVariable name="DATABASE_DSN" value="server=mssql;port=1433;user id=sa;password=Password123;database=guangji;encrypt=disable;" />
                <environmentVariable name="REPORT_BASE_URL" value="http://127.0.0.1" />
                <environmentVariable name="REPORT_USERNAME" value="administrator" />
                <environmentVariable name="REPORT_PASSWORD" value="Hery.senjaya123" />
            </environmentVariables>
        </httpPlatform>

        <!-- To Activate these rules, you must add Allow Headers manually in IIS-->
        <!-- <rewrite>
            <rules>
                <!- - Aturan untuk HTTPS - ->
                <rule name="Inject Forwarded Headers HTTPS" stopProcessing="false">
                <match url=".*" />
                <serverVariables>
                    <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
                    <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                    <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                    <set name="HTTP_X_FORWARDED_PORT" value="{SERVER_PORT}" />
                </serverVariables>
                <conditions>
                    <add input="{HTTPS}" pattern="on" />
                </conditions>
                <action type="None" />
                </rule>

                <!- - Aturan untuk HTTP - ->
                <rule name="Inject Forwarded Headers HTTP" stopProcessing="false">
                <match url=".*" />
                <serverVariables>
                    <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
                    <set name="HTTP_X_FORWARDED_PROTO" value="http" />
                    <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                    <set name="HTTP_X_FORWARDED_PORT" value="{SERVER_PORT}" />
                </serverVariables>
                <conditions>
                    <add input="{HTTPS}" pattern="off" />
                </conditions>
                <action type="None" />
                </rule>
            </rules>
        </rewrite> -->
        <httpProtocol>
        <customHeaders>
            <!-- Menginformasikan client bahwa HTTP/3 (h3) tersedia di port 443 selama 86400 detik (24 jam) -->
            <add name="Alt-Svc" value="h3=&quot;:443&quot;; ma=86400" />
        </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
