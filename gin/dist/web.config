<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>
        <!-- IIS akan otomatis mengisi %HTTP_PLATFORM_PORT% dengan port acak yang bebas -->
        <httpPlatform stdoutLogEnabled="true" stdoutLogFile=".\logs\gin.log" startupTimeLimit="20" processPath=".\server.exe" arguments="">
            <environmentVariables>
                <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>
